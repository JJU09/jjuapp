---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
}

const { title, description, ogTitle } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const navLinks = [
  { href: "/work/", label: "경력" },
  { href: "/projects/", label: "사이드 프로젝트" },
  { href: "/blog/", label: "블로그" },
  { href: "/about/", label: "소개" },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jae Ui · jju09" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google AdSense (사이트 소유권 확인 + 광고) -->
    <meta name="google-adsense-account" content="ca-pub-6535120318685843" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6535120318685843"
      crossorigin="anonymous"></script>

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7GHQKQ6EQT"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7GHQKQ6EQT');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
  </head>
  <body>
    <div class="grid-bg"></div>
    <div class="glow"></div>

    <nav class="site-nav">
      <a class="logo" href="/">jju09</a>
      <div class="links">
        {
          navLinks.map((l) => (
            <a href={l.href} aria-current={current.startsWith(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          ))
        }
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <a href="https://github.com/jju09" target="_blank" rel="noopener">GitHub</a>
      <span class="sep">·</span>
      <a href="https://soundlab.jjuapp.com/" target="_blank" rel="noopener">SoundLab</a>
      <span class="sep">·</span>
      <a href="https://easyaim.jjuapp.com/" target="_blank" rel="noopener">EasyAim</a>
    </footer>
  </body>
</html>
